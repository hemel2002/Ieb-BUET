# PostgreSQL. DATABASE_URL is used by the app (pooled), DATABASE_URL_UNPOOLED by migrations.
# On Vercel, the Neon integration sets both automatically.
# Locally, either paste a Neon development branch's URLs, or run `npx prisma dev` and use the
# postgres:// URL it prints, adding "&connection_limit=1&pgbouncer=true" to the end of both.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Photo storage. When BLOB_READ_WRITE_TOKEN is set (Vercel Blob; set automatically when a Blob
# store is connected), photos are stored there. Otherwise they are written to UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./storage/uploads"

# Secret used to hash commenter IPs and sign comment-form tokens. At least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-a-64-character-random-hex-string"

# Header carrying the real client IP, used for rate limits. Only name a header that your edge
# OVERWRITES with the connecting address (Vercel sets x-real-ip; for nginx use
# `proxy_set_header X-Real-IP $remote_addr;`). A header clients can set themselves lets them
# dodge the per-IP limits.
TRUSTED_IP_HEADER="x-real-ip"

# Set to "true" to run migrations during `npm run vercel-build` outside Vercel production
# (e.g. a Preview environment with its own database). Never point that at production data.
MIGRATE_ON_BUILD=""

# Optional: creates the first administrator during `npm run db:seed` (and on Vercel deploys)
# if no administrator exists yet. Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
