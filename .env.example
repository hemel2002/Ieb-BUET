# SQLite database file (path is relative to prisma/schema.prisma).
DATABASE_URL="file:../storage/ieb.db"

# Where uploaded candidate photos are written. Must be on persistent disk.
UPLOAD_DIR="./storage/uploads"

# Secret used to hash commenter IPs and sign comment-form tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="replace-with-a-64-character-random-hex-string"

# Header carrying the real client IP when running behind a reverse proxy
# (e.g. "x-real-ip" for the nginx config in README, "cf-connecting-ip" for Cloudflare).
# Leave empty to use the last hop of X-Forwarded-For.
TRUSTED_IP_HEADER=""

# Optional: used once by `npm run db:seed` to create the first administrator
# if no administrator exists yet. Remove from the environment afterwards.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
